# Copy to .env locally. Never commit credentials.
# docker compose --env-file services/ai-worker/.env -f docker/docker-compose.yml up --build -d
AI_ENABLED=false
# Docker Desktop can reach local Supabase using host.docker.internal.
SUPABASE_URL=http://host.docker.internal:55321
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Explicitly choose a model supporting Responses strict structured outputs.
OPENAI_MODEL=
AI_POLL_SECONDS=3
