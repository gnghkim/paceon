# Reference only. Next.js reads apps/web/.env.local, not this root file.
# Phase 0 starts without keys. Add Supabase values when integrating Auth in Phase 1.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never use NEXT_PUBLIC_ for privileged credentials.
SUPABASE_SECRET_KEY=
# Host Next.js -> Docker worker; server-only.
AI_WORKER_URL=http://127.0.0.1:8000
