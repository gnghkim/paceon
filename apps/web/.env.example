# Copy to .env.local when adding Supabase integration. No keys needed for Phase 0.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AI_WORKER_URL=http://127.0.0.1:8000

# Optional server-only key; manual registration works without Google Books.
GOOGLE_BOOKS_API_KEY=

# Enable only after the configured AI worker is running. No provider secrets here.
AI_ENABLED=false
