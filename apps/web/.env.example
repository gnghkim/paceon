# Copy to .env.local when adding Supabase integration. No keys needed for Phase 0.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AI_WORKER_URL=http://127.0.0.1:8000

# Optional server-only key; manual registration works without Google Books.
GOOGLE_BOOKS_API_KEY=

# Enable only after the configured AI worker is running. No provider secrets here.
AI_ENABLED=false

# Optional YouTube account connection; see docs/YOUTUBE_SETUP.md.
# Keep all five values server-only. Link saving and embedded playback need no OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Requires the separately configured PDF worker; OpenAI is not required.
PDF_ENABLED=false
# YES24 server-only key; never prefix with NEXT_PUBLIC_.
YES24_API_KEY=
